+/** Runs only on the ConnectivityService thread; leaves VPNs, explicit bindings and netd rules alone. */
+public final class Y700DualNetworkPolicy {
+    public static final String MODE = "y700_dual_network_mode";
+    public static final String TARGETS = "y700_dual_network_ethernet_hosts";
+    public static final String STATUS = "y700_dual_network_status";
+    private static final String TAG = "Y700DualNetwork";
+    private final Context mContext;
+    private final Set<Y700RouteRule> mInstalled = new LinkedHashSet<>();
+    private boolean mCleaned;
+    private String mLastStatus = "";
+
+    public Y700DualNetworkPolicy(Context context) { mContext = context; }
+    public static boolean supported() { return "asphalt".equals(Build.DEVICE); }
+    public static String mode(Context context) {
+        if (!supported()) return "auto";
+        String mode = Settings.Global.getString(context.getContentResolver(), MODE);
+        return "wifi".equals(mode) || "ethernet".equals(mode) ? mode : "auto";
+    }
+    public static int preferredTransport(Context context) {
+        String mode = mode(context);
+        return "wifi".equals(mode) ? TRANSPORT_WIFI
+                : "ethernet".equals(mode) ? TRANSPORT_ETHERNET : -1;
+    }
+    public static boolean keepBoth(Context context) {
+        // Dual-link operation is independent of outlet choice. Do not recycle the standby
+        // connection in automatic mode; radios are still controlled by the existing switches.
+        return supported();
+    }
+    private static List<String> targets(Context context) {
+        String value = Settings.Global.getString(context.getContentResolver(), TARGETS);
+        List<String> result = new ArrayList<>();
+        if (value == null || value.length() > 1024) return result;
+        for (String item : value.split("[\\s,;]+")) {
+            if (!item.isEmpty() && Y700RouteRule.isDeviceAddress(item) && !result.contains(item)) {
+                result.add(item);
+                if (result.size() > 32) return new ArrayList<>();
+            }
+        }
+        return result;
+    }
+    private static boolean connected(NetworkAgentInfo n) {
+        return n.isCreated() && !n.isDestroyed() && n.networkInfo.isConnected();
+    }
+    private static boolean vpnPresent(Collection<NetworkAgentInfo> networks) {
+        for (NetworkAgentInfo n : networks) if (connected(n) && n.isVPN()) return true;
+        return false;
+    }
+    // Called before changing any defaults, so a newly connected VPN never inherits our exceptions.
+    public void beforeRematch(Collection<NetworkAgentInfo> networks) {
+        if (!supported() || !vpnPresent(networks) || mInstalled.isEmpty()) return;
+        try { applyRules(new LinkedHashSet<>()); }
+        catch (Exception e) { Log.e(TAG, "Unable to withdraw device exceptions for VPN", e); }
+    }
+    private static int table(NetworkAgentInfo n) throws Exception {
+        String name = n.linkProperties.getInterfaceName();
+        if (name == null) throw new IllegalStateException("No network interface");
+        NetworkInterface nic = NetworkInterface.getByName(name);
+        if (nic == null || nic.getIndex() <= 0) throw new IllegalStateException("No interface index");
+        // Exact netd RouteController::ROUTE_TABLE_OFFSET_FROM_INDEX, no custom routes required.
+        return 1000 + nic.getIndex();
+    }
+    private static boolean isOwnAddress(InetAddress address, @Nullable NetworkAgentInfo n) {
+        if (n == null) return false;
+        for (LinkAddress a : n.linkProperties.getLinkAddresses()) {
+            if (address.equals(a.getAddress())) return true;
+        }
+        return false;
+    }
+    private static boolean onLink(InetAddress address, NetworkAgentInfo n) {
+        for (LinkAddress a : n.linkProperties.getLinkAddresses()) {
+            if (!(a.getAddress() instanceof Inet4Address)) continue;
+            IpPrefix prefix = new IpPrefix(a.getAddress(), a.getPrefixLength());
+            if (!prefix.contains(address)) continue;
+            if (a.getPrefixLength() >= 31) return true;
+            byte[] network = prefix.getRawAddress(), host = address.getAddress();
+            boolean networkAddress = true, broadcast = true;
+            for (int bit = a.getPrefixLength(); bit < 32; bit++) {
+                int mask = 1 << (7 - bit % 8);
+                if ((host[bit / 8] & mask) != 0) networkAddress = false;
+                else broadcast = false;
+            }
+            return !networkAddress && !broadcast;
+        }
+        return false;
+    }
+    private static String addresses(@Nullable NetworkAgentInfo n) {
+        if (n == null) return "";
+        List<String> values = new ArrayList<>();
+        for (LinkAddress a : n.linkProperties.getLinkAddresses()) {
+            if (a.getAddress() instanceof Inet4Address) values.add(a.toString());
