+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.network;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.text.InputType;
+import android.widget.Toast;
+import androidx.preference.EditTextPreference;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.Lifecycle;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnResume;
+import com.android.settingslib.core.lifecycle.events.OnPause;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import org.json.JSONObject;
+
+/** Owner-only UI; all routing is performed by ConnectivityService without a root app. */
+public final class Y700DualNetworkPreferenceController extends BasePreferenceController
+        implements LifecycleObserver, OnResume, OnPause {
+    private static final String MODE = "y700_dual_network_mode";
+    private static final String TARGETS = "y700_dual_network_ethernet_hosts";
+    private static final String STATUS = "y700_dual_network_status";
+    private ListPreference mMode;
+    private EditTextPreference mTargets;
+    private Preference mStatus;
+    private final ContentObserver mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+        @Override public void onChange(boolean selfChange) { refresh(); }
+    };
+    public Y700DualNetworkPreferenceController(Context context, Lifecycle lifecycle) {
+        super(context, "y700_dual_network_category");
+        lifecycle.addObserver(this);
+    }
+    @Override public int getAvailabilityStatus() {
+        UserManager users = mContext.getSystemService(UserManager.class);
+        return "asphalt".equals(Build.DEVICE) && users != null && users.isAdminUser()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+    @Override public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        Preference category = screen.findPreference(getPreferenceKey());
+        if (category != null) category.setVisible(isAvailable());
+        if (!isAvailable()) return;
+        mMode = screen.findPreference(MODE);
+        mTargets = screen.findPreference(TARGETS);
+        mStatus = screen.findPreference(STATUS);
+        if (mMode == null || mTargets == null || mStatus == null) return;
+        mMode.setOnPreferenceChangeListener((p, value) -> {
+            String mode = String.valueOf(value);
+            if (!mode.equals("auto") && !mode.equals("wifi") && !mode.equals("ethernet")) return false;
+            boolean ok = Settings.Global.putString(mContext.getContentResolver(), MODE, mode);
+            if (!ok) notifyError(R.string.y700_dualnet_apply_failed);
+            return ok;
+        });
+        mTargets.setOnBindEditTextListener(edit -> {
+            edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE
+                    | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+            edit.setSingleLine(false);
+            edit.setMinLines(3);
+            edit.setHint(R.string.y700_dualnet_hosts_hint);
+        });
+        mTargets.setOnPreferenceChangeListener((p, value) -> {
+            String normalized = normalizeHosts(String.valueOf(value));
+            if (normalized == null) { notifyError(R.string.y700_dualnet_invalid_hosts); return false; }
+            boolean ok = Settings.Global.putString(mContext.getContentResolver(), TARGETS, normalized);
+            if (!ok) notifyError(R.string.y700_dualnet_apply_failed);
+            // The observer supplies canonical text; do not persist the original unnormalized input.
+            if (ok) mTargets.setText(normalized);
+            return false;
+        });
+        refresh();
+    }
+    private void notifyError(int text) { Toast.makeText(mContext, text, Toast.LENGTH_LONG).show(); }
+    static String normalizeHosts(String value) {
+        if (value.length() > 1024) return null;
+        Set<String> hosts = new LinkedHashSet<>();
+        for (String host : value.trim().split("[\\s,;]+")) {
+            if (host.isEmpty()) continue;
+            if (!host.matches("[0-9]{1,3}(\\.[0-9]{1,3}){3}")) return null;
+            String[] parts = host.split("\\.");
+            int first = Integer.parseInt(parts[0]);
+            if (first == 0 || first == 127 || first >= 224) return null;
+            for (String part : parts) {
+                if (Integer.parseInt(part) > 255 || (part.length() > 1 && part.startsWith("0"))) return null;
+            }
+            hosts.add(host);
+            if (hosts.size() > 32) return null;
+        }
+        return String.join("\n", hosts);
+    }
+    @Override public void onResume() {
+        if (!isAvailable()) return;
+        for (String key : new String[] {MODE, TARGETS, STATUS}) {
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Global.getUriFor(key), false, mObserver);
+        }
+        refresh();
+    }
+    @Override public void onPause() { mContext.getContentResolver().unregisterContentObserver(mObserver); }
+    private String networkName(String value) {
+        if (value.equals("wifi")) return mContext.getString(R.string.y700_dualnet_wifi);
+        if (value.equals("ethernet")) return mContext.getString(R.string.ethernet);
+        if (value.equals("vpn")) return "VPN";
+        return mContext.getString(R.string.y700_dualnet_no_default);
+    }
+    private void refresh() {
+        if (mMode == null || mTargets == null || mStatus == null) return;
+        String mode = Settings.Global.getString(mContext.getContentResolver(), MODE);
+        if (!"wifi".equals(mode) && !"ethernet".equals(mode)) mode = "auto";
+        mMode.setValue(mode);
+        mMode.setSummary(mMode.getEntry());
+        String hosts = Settings.Global.getString(mContext.getContentResolver(), TARGETS);
+        hosts = hosts == null ? "" : hosts;
+        mTargets.setText(hosts);
+        mTargets.setSummary(hosts.isEmpty() ? mContext.getString(R.string.y700_dualnet_hosts_summary) : hosts);
+        try {
+            String raw = Settings.Global.getString(mContext.getContentResolver(), STATUS);
+            if (raw == null) throw new IllegalStateException("Waiting for system service");
+            JSONObject status = new JSONObject(raw);
+            String summary = mContext.getString(R.string.y700_dualnet_live_status,
+                    networkName(status.optString("default")),
+                    status.optString("wifi", ""), status.optString("ethernet", ""),
+                    status.optInt("active"), status.optInt("pending"));
+            if (!status.optBoolean("validated")) summary += "\n" + mContext.getString(R.string.y700_dualnet_not_validated);
+            if (status.optBoolean("vpn_paused")) summary += "\n" + mContext.getString(R.string.y700_dualnet_vpn_paused);
+            if (!status.optString("error").isEmpty()) summary += "\n" + mContext.getString(R.string.y700_dualnet_apply_failed);
+            mStatus.setSummary(summary);
+        } catch (Exception e) { mStatus.setSummary(R.string.y700_dualnet_waiting); }
+    }
+}
