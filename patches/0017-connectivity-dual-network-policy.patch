+        if (n.networkCapabilities.hasTransport(TRANSPORT_ETHERNET)) return "ethernet";
+        return "other";
+    }
+    public void refresh(Collection<NetworkAgentInfo> networks,
+            @Nullable NetworkAgentInfo defaultNetwork) {
+        if (!supported()) return;
+        NetworkAgentInfo wifi = null, ethernet = null;
+        for (NetworkAgentInfo n : networks) {
+            if (!connected(n) || n.isVPN()) continue;
+            if (n.networkCapabilities.hasTransport(TRANSPORT_WIFI)
+                    && (wifi == null || n == defaultNetwork)) wifi = n;
+            if (n.networkCapabilities.hasTransport(TRANSPORT_ETHERNET)
+                    && (ethernet == null || n == defaultNetwork)) ethernet = n;
+        }
+        List<String> requested = targets(mContext);
+        boolean vpn = vpnPresent(networks);
+        Set<Y700RouteRule> desired = new LinkedHashSet<>();
+        int active = 0;
+        String error = "";
