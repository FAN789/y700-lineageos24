+            if (!mCleaned) { cleanupOwnedRules(); mCleaned = true; }
+            if (!vpn && ethernet != null && !requested.isEmpty()) {
+                Set<Integer> marks = new LinkedHashSet<>(); marks.add(0);
+                marks.add(ethernet.network.netId);
+                if (wifi != null) marks.add(wifi.network.netId);
+                int ethernetTable = table(ethernet);
+                Set<String> activeHosts = new LinkedHashSet<>();
+                for (String host : requested) {
+                    InetAddress address = InetAddress.getByName(host); // Strict numeric IPv4 above.
+                    if (!onLink(address, ethernet) || isOwnAddress(address, ethernet)
+                            || isOwnAddress(address, wifi)) continue;
+                    for (int mark : marks) desired.add(new Y700RouteRule(host, ethernetTable, mark, 0));
+                    active++; activeHosts.add(host);
+                }
+                // Preserve DNS over the chosen Internet network even when its DNS/router has
+                // the same address as a wired device. Applies to unmarked native sockets too.
+                if (active > 0 && defaultNetwork != null && !defaultNetwork.isVPN()) {
+                    int internetTable = table(defaultNetwork);
+                    for (InetAddress dns : defaultNetwork.linkProperties.getDnsServers()) {
+                        String host = dns.getHostAddress();
+                        if (!(dns instanceof Inet4Address) || !activeHosts.contains(host)) continue;
+                        for (int mark : marks) {
+                            desired.add(new Y700RouteRule(host, internetTable, mark, 6));
+                            desired.add(new Y700RouteRule(host, internetTable, mark, 17));
+                        }
+                    }
+                }
+            }
+            applyRules(desired);
+        } catch (Exception e) {
+            active = 0; error = "route_apply_failed";
+            Log.e(TAG, "Keeping standard network routing after device-rule failure", e);
+        }
+        try {
+            JSONArray dns = new JSONArray();
+            if (defaultNetwork != null) {
+                for (InetAddress server : defaultNetwork.linkProperties.getDnsServers()) {
+                    dns.put(server.getHostAddress());
+                }
+            }
+            String status = new JSONObject().put("dns", dns)
+                    .put("validated", defaultNetwork != null && defaultNetwork.networkCapabilities
+                            .hasCapability(android.net.NetworkCapabilities.NET_CAPABILITY_VALIDATED))
+                    .put("mode", mode(mContext))
+                    .put("default", transport(defaultNetwork)).put("wifi", addresses(wifi))
+                    .put("ethernet", addresses(ethernet)).put("requested", requested.size())
+                    .put("active", active).put("pending", requested.size() - active)
+                    .put("vpn_paused", vpn && !requested.isEmpty()).put("error", error).toString();
+            if (!status.equals(mLastStatus)) {
+                Settings.Global.putString(mContext.getContentResolver(), STATUS, status);
+                mLastStatus = status;
+            }
+        } catch (Exception e) { Log.e(TAG, "Unable to publish network policy state", e); }
+    }
+    private static void send(byte[] message) throws ErrnoException {
+        NetlinkUtils.sendOneShotKernelMessage(NETLINK_ROUTE, message);
+    }
+    private void applyRules(Set<Y700RouteRule> desired) throws ErrnoException {
+        // Retire old rules first when interfaces/defaults change. A failure leaves normal Android
+        // routing in place; no stale rule may point at an interface index reused by another NIC.
+        for (Y700RouteRule old : new ArrayList<>(mInstalled)) {
+            if (desired.contains(old)) continue;
+            try { send(old.message(false)); }
+            catch (ErrnoException e) { if (e.errno != OsConstants.ENOENT) throw e; }
+            mInstalled.remove(old);
+        }
+        List<Y700RouteRule> added = new ArrayList<>();
+        try {
+            for (Y700RouteRule rule : desired) {
+                if (mInstalled.contains(rule)) continue;
+                send(rule.message(true)); mInstalled.add(rule); added.add(rule);
+            }
+        } catch (ErrnoException e) {
+            for (Y700RouteRule rule : added) {
+                try { send(rule.message(false)); mInstalled.remove(rule); }
+                catch (ErrnoException cleanupError) { Log.e(TAG, "Rule rollback failed", cleanupError); }
+            }
+            throw e;
+        }
+    }
+    private static void cleanupOwnedRules() throws Exception {
+        FileDescriptor fd = NetlinkUtils.netlinkSocketForProto(NETLINK_ROUTE, 1024 * 1024);
+        List<byte[]> deletes = new ArrayList<>();
+        try {
+            NetlinkUtils.connectToKernel(fd);
+            byte[] request = Y700RouteRule.dumpRequest();
+            NetlinkUtils.sendMessage(fd, request, 0, request.length, 1000);
+            boolean done = false;
+            for (int count = 0; count < 128 && !done; count++) {
+                ByteBuffer b = NetlinkUtils.recvMessage(fd, 65536, 1000)
+                        .order(ByteOrder.nativeOrder());
+                deletes.addAll(Y700RouteRule.ownedDeletes(b));
+                for (int at = b.position(); at + 16 <= b.limit();) {
+                    int len = b.getInt(at);
+                    if (len < 16 || at + len > b.limit()) throw new IllegalStateException("Bad rule dump");
+                    int type = Short.toUnsignedInt(b.getShort(at + 4));
+                    if (type == 3) done = true;
+                    if (type == 2) throw new IllegalStateException("Rule dump rejected");
+                    at += (len + 3) & ~3;
+                }
+            }
+            if (!done) throw new IllegalStateException("Incomplete rule dump");
+        } finally { Os.close(fd); }
+        for (byte[] delete : deletes) {
+            try { send(delete); }
+            catch (ErrnoException e) { if (e.errno != OsConstants.ENOENT) throw e; }
+        }
+    }
