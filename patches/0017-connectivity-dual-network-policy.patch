+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.connectivity;
+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+
+/** Scoped IPv4 policy rules. No shell commands and no changes to netd-owned rules/tables. */
+public final class Y700RouteRule {
+    public static final int DNS_PRIORITY = 18040;
+    public static final int DEVICE_PRIORITY = 18050;
+    public static final int OWNER_PROTOCOL = 242;
+    // netd Fwmark: 16-bit netId, followed by explicitlySelected. Explicit app bindings win.
+    public static final int MARK_MASK = 0x1ffff;
+    public final String destination;
+    public final int table;
+    public final int mark;
+    public final int ipProtocol;
+
+    public Y700RouteRule(String destination, int table, int mark, int ipProtocol) {
+        if (table <= 1000 || table >= 1000000000 || mark < 0 || mark > 65535
+                || (ipProtocol != 0 && ipProtocol != 6 && ipProtocol != 17)) {
+            throw new IllegalArgumentException("Invalid policy rule");
+        }
+        if (!isDeviceAddress(destination)) {
+            throw new IllegalArgumentException("Invalid device IPv4");
+        }
+        this.destination = destination;
+        this.table = table;
+        this.mark = mark;
+        this.ipProtocol = ipProtocol;
+    }
+
+    public static boolean isDeviceAddress(String value) {
+        if (value == null || !value.matches("[0-9]{1,3}(\\.[0-9]{1,3}){3}")) return false;
+        String[] parts = value.split("\\.");
+        int first = Integer.parseInt(parts[0]);
+        for (String p : parts) {
+            if (Integer.parseInt(p) > 255 || (p.length() > 1 && p.startsWith("0"))) return false;
+        }
+        return first > 0 && first < 224 && first != 127
+                && !value.equals("255.255.255.255");
+    }
+
+    private static void attr(ByteBuffer b, int type, byte[] data) {
+        b.putShort((short) (4 + data.length)).putShort((short) type).put(data);
+        while ((b.position() & 3) != 0) b.put((byte) 0);
+    }
+
+    private static byte[] integer(int n) {
+        return ByteBuffer.allocate(4).order(ByteOrder.nativeOrder()).putInt(n).array();
+    }
+
+    public byte[] message(boolean add) {
+        ByteBuffer b = ByteBuffer.allocate(128).order(ByteOrder.nativeOrder());
+        b.putInt(0).putShort((short) (add ? 32 : 33)) // RTM_NEWRULE / RTM_DELRULE
+                .putShort((short) (add ? 0x605 : 5)).putInt(1).putInt(0);
+        b.put((byte) 2).put((byte) 32)
+                .put((byte) 0).put((byte) 0).putInt(0).putInt(0);
+        // fib_rule_hdr's action is a byte, not an endian-dependent integer.
+        b.put(23, (byte) 1); // FR_ACT_TO_TBL
+        b.put(20, (byte) 0); b.put(21, (byte) 0); b.put(22, (byte) 0);
+        if (destination != null) {
+            String[] p = destination.split("\\.");
+            attr(b, 1, new byte[] {(byte) Integer.parseInt(p[0]),
+                    (byte) Integer.parseInt(p[1]), (byte) Integer.parseInt(p[2]),
+                    (byte) Integer.parseInt(p[3])});
+        }
+        attr(b, 3, new byte[] {'l', 'o', 0}); // Local output only; never alter tethered traffic.
+        attr(b, 6, integer(ipProtocol != 0 ? DNS_PRIORITY : DEVICE_PRIORITY));
+        attr(b, 10, integer(mark));
+        attr(b, 15, integer(table));
+        attr(b, 16, integer(MARK_MASK));
+        attr(b, 21, new byte[] {(byte) OWNER_PROTOCOL});
+        if (ipProtocol != 0) {
+            attr(b, 22, new byte[] {(byte) ipProtocol});
+            attr(b, 24, ByteBuffer.allocate(4).order(ByteOrder.nativeOrder())
+                    .putShort((short) 53).putShort((short) 53).array());
+        }
+        b.putInt(0, b.position());
+        return Arrays.copyOf(b.array(), b.position());
+    }
+
+    public static byte[] dumpRequest() {
+        ByteBuffer b = ByteBuffer.allocate(28).order(ByteOrder.nativeOrder());
+        b.putInt(28).putShort((short) 34).putShort((short) 0x301).putInt(1).putInt(0);
+        b.put((byte) 2);
+        return b.array();
+    }
+
+    /** Return deletes only for our exact family, priorities, protocol and mark mask. */
+    public static List<byte[]> ownedDeletes(ByteBuffer input) {
+        List<byte[]> result = new ArrayList<>();
+        ByteBuffer b = input.duplicate().order(ByteOrder.nativeOrder());
+        while (b.remaining() >= 16) {
+            int start = b.position();
+            int length = b.getInt(start);
+            if (length < 16 || length > b.remaining()) break;
+            int type = Short.toUnsignedInt(b.getShort(start + 4));
+            if (type == 32 && length >= 28 && b.get(start + 16) == 2) {
+                int priority = -1, protocol = -1, mask = -1;
+                for (int at = start + 28; at + 4 <= start + length;) {
+                    int n = Short.toUnsignedInt(b.getShort(at));
+                    int kind = Short.toUnsignedInt(b.getShort(at + 2)) & 0x3fff;
+                    if (n < 4 || at + n > start + length) break;
+                    if (kind == 6 && n == 8) priority = b.getInt(at + 4);
+                    if (kind == 16 && n == 8) mask = b.getInt(at + 4);
+                    if (kind == 21 && n == 5) protocol = Byte.toUnsignedInt(b.get(at + 4));
+                    at += (n + 3) & ~3;
+                }
+                if ((priority == DNS_PRIORITY || priority == DEVICE_PRIORITY)
+                        && protocol == OWNER_PROTOCOL && mask == MARK_MASK) {
+                    byte[] raw = new byte[length];
+                    ByteBuffer copy = b.duplicate(); copy.position(start); copy.get(raw);
+                    ByteBuffer edit = ByteBuffer.wrap(raw).order(ByteOrder.nativeOrder());
+                    edit.putShort(4, (short) 33).putShort(6, (short) 5)
+                            .putInt(8, 1).putInt(12, 0);
+                    result.add(raw);
+                }
+            }
+            b.position(start + ((length + 3) & ~3));
+        }
+        return result;
+    }
+
+    @Override public boolean equals(Object o) {
+        if (!(o instanceof Y700RouteRule)) return false;
+        Y700RouteRule r = (Y700RouteRule) o;
+        return table == r.table && mark == r.mark && ipProtocol == r.ipProtocol
+                && Objects.equals(destination, r.destination);
+    }
+    @Override public int hashCode() { return Objects.hash(destination, table, mark, ipProtocol); }
+}
